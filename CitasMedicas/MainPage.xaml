<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CitasMedicas.MainPage"
             Title="Citas">

    <VerticalStackLayout VerticalOptions="Center" Padding="30" Spacing="15">

        <Label Text="Citas médicas"
               FontSize="28"
               HorizontalOptions="Center" />

        <Button Text="Solicitar cita" Clicked="SolicitarCitaClicked" />

        <Button Text="Consulta de citas" Clicked="VerCitasClicked" />

    </VerticalStackLayout>
</ContentPage>
